<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/setupPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="112dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:paddingTop="44dp"
            android:paddingBottom="12dp">

            <!-- ── 头部：圆角方形头像 + 标题 ── -->
            <ImageView
                android:id="@+id/heroIcon"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center_horizontal"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_image"
                android:contentDescription="@string/app_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:text="@string/welcome_title"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/hintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_secondary" />

            <!-- ── 主内容纸面 ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_sheet"
                android:elevation="3dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <!-- 服务器地址 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_server"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <EditText
                    android:id="@+id/urlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:hint="@string/url_hint"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="#BFB3A6"
                    android:inputType="textUri"
                    android:imeOptions="actionDone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="18dp"
                    android:background="#F3EDE8" />

                <!-- 通知推送 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notify_section"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/notify_chat"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/notifyChat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/notify_moments"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/notifyMoments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/notify_comments"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/notifyComments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/notify_group"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/notifyGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/notify_mailbox"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/notifyMailbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/notify_events"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/notifyEvents"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/notify_system_hint"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/hideServiceNotifyBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/hide_service_notify"
                    android:textSize="13sp"
                    android:textColor="@color/accent_dark" />
            </LinearLayout>

            <!-- ── 保活提醒（醒目卡片）── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_callout"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_callout_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_dark" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/battery_callout_text"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/goBackgroundSettingsBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/battery_go"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_dark" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── 底部上滑确认区（固定，不随内容滚动）── -->
    <LinearLayout
        android:id="@+id/swipeBar"
        android:layout_width="match_parent"
        android:layout_height="118dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_horizontal|bottom"
        android:background="@drawable/bg_swipe_fade"
        android:paddingBottom="30dp">

        <ImageView
            android:id="@+id/swipeChevron"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_swipe_up"
            android:contentDescription="@string/swipe_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/swipe_hint"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textColor="@color/accent_dark" />
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
